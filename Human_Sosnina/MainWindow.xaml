<Window x:Class="Human_Sosnina.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Human_Sosnina"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Content="Диалог" Click="Start_Click" Width="150" Height="40" Margin="5" 
            HorizontalAlignment="Center" Grid.Row="0"/>

        <StackPanel Orientation="Horizontal" Name="Parent" Grid.Row="1">
            
        </StackPanel>
    </Grid>
</Window>
